        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(offerId) && isVerifiedUser() && isValidPriceLockOffer(incoming())
        && incoming().id == existing().id
        && incoming().venueId == existing().venueId
        && incoming().partnerUserId == existing().partnerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (existing().partnerUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'weekdayPrice', 'weekendPrice', 'albaAdvancePrice', 'discountPercent', 'availableSlots', 'activityDate', 'bookingDeadline', 'expiresAt', 'partnerTerms', 'cancellationPolicy', 'offerStatus', 'updatedAt']))
        );
      allow delete: if isValidId(offerId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (
        existing().customerId == request.auth.uid || existing().partnerUserId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || resource.data.partnerUserId == request.auth.uid || isAdminByEmail()
      );
      allow create: if isValidId(bookingId) && isVerifiedUser()
        && isValidBooking(incoming())
        && incoming().id == bookingId
        && incoming().customerId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().paymentStatus in ['unpaid', 'instructions_sent']
        && exists(/databases/$(database)/documents/venues/$(incoming().venueId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId) && isVerifiedUser() && isValidBooking(incoming())
        && incoming().id == existing().id
        && incoming().idempotencyKey == existing().idempotencyKey
        && incoming().customerId == existing().customerId
        && incoming().venueId == existing().venueId
        && incoming().partnerUserId == existing().partnerUserId
        && incoming().lockedUnitPrice == existing().lockedUnitPrice
        && incoming().grossAmount == existing().grossAmount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && !(existing().status in ['rejected', 'refunded'])
        && (
          isAdmin()
          || (
            existing().customerId == request.auth.uid
            && (
              (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                && existing().status in ['draft', 'pending', 'accepted', 'confirmed']
                && incoming().status in ['cancelled', 'refund_requested'])
              || (incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
                && incoming().paymentStatus == 'reference_submitted')
            )
          )
          || (
            existing().partnerUserId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
            && existing().status in ['pending', 'accepted', 'confirmed']
            && incoming().status in ['accepted', 'rejected', 'confirmed', 'completed']
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /booking_status_history/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && (
        existing().customerId == request.auth.uid || existing().partnerUserId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || resource.data.partnerUserId == request.auth.uid || isAdminByEmail()
      );
      allow create: if isValidId(historyId) && isVerifiedUser()
        && isValidBookingStatusHistory(incoming())
        && incoming().id == historyId
        && incoming().changedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (
        existing().customerId == request.auth.uid || existing().partnerUserId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || resource.data.partnerUserId == request.auth.uid || isAdminByEmail()
      );
      allow create: if isValidId(paymentId) && isVerifiedUser()
        && isValidPayment(incoming())
        && incoming().id == paymentId
        && (incoming().customerId == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(paymentId) && isVerifiedUser() && isValidPayment(incoming())
        && incoming().id == existing().id
        && incoming().bookingId == existing().bookingId
        && incoming().customerId == existing().customerId
        && incoming().partnerUserId == existing().partnerUserId
        && incoming().amount == existing().amount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (existing().customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['transactionRef', 'status', 'updatedAt']) && incoming().status == 'reference_submitted')
          || (existing().partnerUserId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'verified')
        );
      allow delete: if isValidId(paymentId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().moderationStatus == 'published' || (isSignedIn() && existing().customerId == request.auth.uid) || isAdmin());
      allow list: if resource.data.moderationStatus == 'published' || (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdminByEmail();
      allow create: if isValidId(reviewId) && isVerifiedUser()
        && isValidReview(incoming())
        && incoming().id == reviewId
        && incoming().customerId == request.auth.uid
        && incoming().isVerifiedBooking == true
        && incoming().moderationStatus == 'published'
        && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'completed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reviewId) && isVerifiedUser() && isValidReview(incoming())
        && incoming().id == existing().id
        && incoming().venueId == existing().venueId
        && incoming().bookingId == existing().bookingId
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/venues/$(existing().venueId)).data.partnerUserId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['partnerResponse', 'updatedAt'])
          )
        );
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminByEmail());
      allow create: if isValidId(notificationId) && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().id == notificationId
        && incoming().isRead == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(notificationId) && isSignedIn() && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])));
      allow delete: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    match /favourites/{favouriteId} {
      allow get: if isValidId(favouriteId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminByEmail());
      allow create: if isValidId(favouriteId) && isVerifiedUser()
        && isValidFavourite(incoming())
        && incoming().id == favouriteId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(favouriteId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminByEmail());
      allow create: if isValidId(ticketId) && isVerifiedUser()
        && isValidSupportTicket(incoming())
        && incoming().id == ticketId
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) && isVerifiedUser() && isValidSupportTicket(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'closed'));
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    match /support_messages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn() && (
        isAdmin()
        || (existing().ticketOwnerId == request.auth.uid && existing().isInternalNote == false)
      );
      allow list: if isSignedIn() && (
        isAdminByEmail()
        || (resource.data.ticketOwnerId == request.auth.uid && resource.data.isInternalNote == false)
      );
      allow create: if isValidId(messageId) && isVerifiedUser()
        && isValidSupportMessage(incoming())
        && incoming().id == messageId
        && incoming().senderId == request.auth.uid
        && exists(/databases/$(database)/documents/support_tickets/$(incoming().ticketId))
        && (
          isAdmin()
          || (
            incoming().ticketOwnerId == request.auth.uid
            && incoming().isInternalNote == false
            && incoming().senderRole in ['customer', 'venue_partner']
          )
        )
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /settlements/{settlementId} {
      allow get: if isValidId(settlementId) && isSignedIn() && (existing().partnerUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.partnerUserId == request.auth.uid || isAdminByEmail());
      allow create, update: if isValidId(settlementId) && isAdmin() && isValidSettlement(incoming())
        && incoming().createdAt is timestamp && incoming().updatedAt == request.time;
      allow delete: if isValidId(settlementId) && isAdmin();
    }

    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if resource.data.defaultCommissionPercent >= 0;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidPlatformSetting(incoming())
        && incoming().id == settingId && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /audit_logs/{logId} {
      allow get, list: if isAdminByEmail();
      allow create: if isValidId(logId) && isVerifiedUser()
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
