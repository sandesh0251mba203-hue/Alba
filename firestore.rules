        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(venueId) && isVerifiedUser() && isValidVenue(incoming())
        && incoming().id == existing().id
        && incoming().partnerUserId == existing().partnerUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().partnerUserId == request.auth.uid
            && incoming().verificationStatus == existing().verificationStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'city', 'locality', 'address', 'description', 'imageUrl', 'videoPreviewUrl', 'operatingHours', 'weekdayPrice', 'weekendPrice', 'lat', 'lng', 'updatedAt'])
          )
        );
      allow delete: if isValidId(venueId) && isAdmin();
    }

    match /venue_partners/{partnerId} {
      allow get: if isValidId(partnerId) && (isSignedIn() && (existing().userId == request.auth.uid || isAdmin()));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminByEmail());
