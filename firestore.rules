          || (
            request.auth.uid in get(/databases/$(database)/documents/itineraries/$(existing().itineraryId)).data.memberIds
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
            && request.auth.uid in incoming().memberIds
          )
        );
      allow delete: if isValidId(voteId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
