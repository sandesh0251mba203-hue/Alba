        || isAdmin()
      );
      allow list: if resource.data.verificationStatus == 'approved'
        || (isSignedIn() && resource.data.partnerUserId == request.auth.uid)
        || isAdminByEmail();
      allow create: if isValidId(venueId) && isVerifiedUser()
        && isValidVenue(incoming())
        && incoming().id == venueId
        && (
          isAdmin()
          || (
            incoming().partnerUserId == request.auth.uid
            && incoming().verificationStatus == 'pending'
            && (!('isIllustrativeListing' in incoming()) || incoming().isIllustrativeListing == false)
