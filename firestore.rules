            incoming().suggestedByUserId == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/itineraries/$(incoming().itineraryId)).data.memberIds
          )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(stopId) && isVerifiedUser() && isValidItineraryStop(incoming())
        && incoming().id == existing().id
        && incoming().itineraryId == existing().itineraryId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['orderIndex', 'timeSlot', 'durationMinutes', 'title', 'category', 'locality', 'description', 'estimatedCostPerPerson', 'priceType', 'travelTimeNote', 'venueId', 'memberIds', 'alternativeOption', 'updatedAt']))
          || (
